<Window x:Class="SnakeGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnakeGame"
        mc:Ignorable="d"
        Title="Snake Game"
        Width="700"
        Height="620"
        MinWidth="700"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#060b14">
    <Window.Resources>
        <Style x:Key="NeonTextStyle" TargetType="TextBlock">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#162236"/>
            <Setter Property="BorderBrush" Value="#2d4966"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush x:Name="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="BackgroundStop1" Color="#080b1c" Offset="0"/>
                <GradientStop x:Name="BackgroundStop2" Color="#111735" Offset="0.5"/>
                <GradientStop x:Name="BackgroundStop3" Color="#202052" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Margin="8"
                Background="Transparent"
                BorderBrush="#214d43"
                BorderThickness="1"
                CornerRadius="24"
                Panel.ZIndex="100"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#16a34a" BlurRadius="24" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>
        </Border>

        <Canvas IsHitTestVisible="False" Opacity="0.7">
            <Ellipse Width="3" Height="3" Fill="#67e8f9" Canvas.Left="34" Canvas.Top="48"/>
            <Ellipse Width="2" Height="2" Fill="#a78bfa" Canvas.Left="118" Canvas.Top="132"/>
            <Ellipse Width="3" Height="3" Fill="#67e8f9" Canvas.Left="226" Canvas.Top="30"/>
            <Ellipse Width="2" Height="2" Fill="#c084fc" Canvas.Left="338" Canvas.Top="92"/>
            <Ellipse Width="3" Height="3" Fill="#67e8f9" Canvas.Left="506" Canvas.Top="42"/>
            <Ellipse Width="2" Height="2" Fill="#a78bfa" Canvas.Left="628" Canvas.Top="155"/>
            <Ellipse Width="3" Height="3" Fill="#c084fc" Canvas.Left="654" Canvas.Top="312"/>
            <Ellipse Width="2" Height="2" Fill="#67e8f9" Canvas.Left="54" Canvas.Top="386"/>
            <Ellipse Width="3" Height="3" Fill="#a78bfa" Canvas.Left="112" Canvas.Top="536"/>
            <Ellipse Width="2" Height="2" Fill="#67e8f9" Canvas.Left="284" Canvas.Top="584"/>
            <Ellipse Width="3" Height="3" Fill="#c084fc" Canvas.Left="472" Canvas.Top="550"/>
            <Ellipse Width="2" Height="2" Fill="#67e8f9" Canvas.Left="612" Canvas.Top="474"/>
        </Canvas>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#d9111828"
                    BorderBrush="#214d43"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,14"
                    Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.35"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SNAKE"
                                   FontSize="30"
                                   FontWeight="ExtraBold"
                                   Style="{StaticResource NeonTextStyle}"
                                   Foreground="#7dd3fc">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#38bdf8" BlurRadius="12" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock Text="ERDIS-ALKION EDITION"
                                   Margin="2,1,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#64748b"/>
                    </StackPanel>

                    <TextBlock x:Name="WinsTextBlock"
                               Grid.Column="1"
                               Text="Win streak: 0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#ff4d6d"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource NeonTextStyle}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#ff1744" BlurRadius="12" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Border Grid.Column="2"
                            Style="{StaticResource PillBorderStyle}"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveStatusDot" Width="7" Height="7" Fill="#ef4444" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LiveStatusTextBlock" Text="OFFLINE" FontSize="11" FontWeight="Bold" Foreground="#f87171"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ScoreTextBlock"
                               Grid.Column="3"
                               Text="Score: 0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#86efac"
                               Margin="0,0,20,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource NeonTextStyle}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#4ade80" BlurRadius="12" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock x:Name="BestTextBlock"
                               Grid.Column="4"
                               Text="Best: 0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#fbbf24"
                               VerticalAlignment="Center"
                               Style="{StaticResource NeonTextStyle}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#fbbf24" BlurRadius="12" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Width="396"
                    Height="396"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#081c1b"
                    BorderBrush="#34d399"
                    BorderThickness="2"
                    CornerRadius="18"
                    Padding="14">
                <Border.Effect>
                    <DropShadowEffect Color="#22c55e" BlurRadius="24" ShadowDepth="0" Opacity="0.38"/>
                </Border.Effect>
                <Grid>
                    <Border BorderBrush="#15803d"
                            BorderThickness="2"
                            CornerRadius="12"
                            Margin="0"
                            IsHitTestVisible="False"/>
                    <Canvas x:Name="GameCanvas"
                            Width="360"
                            Height="360"
                            SnapsToDevicePixels="True"
                            Background="#020617"/>

                    <Border x:Name="GameOverOverlay"
                            Width="240"
                            Height="120"
                            Background="#0f172a"
                            BorderBrush="#ef4444"
                            BorderThickness="3"
                            CornerRadius="12"
                            Opacity="0.9"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="GAME OVER"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#f87171"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource NeonTextStyle}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#f87171" BlurRadius="12" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="Click to restart"
                                       Margin="0,8,0,0"
                                       FontSize="18"
                                       Foreground="#f8fafc"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource NeonTextStyle}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#f8fafc" BlurRadius="10" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="WinnerOverlay"
                          Width="320"
                          Height="210"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Border BorderBrush="#fbbf24"
                                BorderThickness="2"
                                CornerRadius="22"
                                Opacity="0.96">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#cc27104f" Offset="0"/>
                                    <GradientStop Color="#e65b1b70" Offset="0.52"/>
                                    <GradientStop Color="#cc9b5b13" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#fbbf24" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="★  WINNER  ★"
                                       FontSize="42"
                                       FontWeight="ExtraBold"
                                       Foreground="#fbbf24"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource NeonTextStyle}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#fbbf24" BlurRadius="18" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="CHAMPION MODE UNLOCKED"
                                       Margin="0,12,0,0"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#fef3c7"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource NeonTextStyle}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#fbbf24" BlurRadius="10" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="Your run is legendary"
                                       Margin="0,7,0,0"
                                       FontSize="12"
                                       Foreground="#fde68a"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#b3142236"
                        BorderBrush="#263b55"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,8">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Press Space to start or pause"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#cbd5e1"
                               HorizontalAlignment="Center"
                               Style="{StaticResource NeonTextStyle}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#cbd5e1" BlurRadius="8" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="MOVE" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,5,0"/>
                    <TextBlock Text="ARROWS / WASD" FontSize="10" FontWeight="SemiBold" Foreground="#94a3b8" Margin="0,0,18,0"/>
                    <TextBlock Text="PAUSE" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,5,0"/>
                    <TextBlock Text="SPACE" FontSize="10" FontWeight="SemiBold" Foreground="#94a3b8" Margin="0,0,18,0"/>
                    <TextBlock Text="RESTART" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,5,0"/>
                    <TextBlock Text="R" FontSize="10" FontWeight="SemiBold" Foreground="#94a3b8"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
